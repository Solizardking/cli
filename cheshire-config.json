{
  "name": "cheshire-terminal",
  "description": "Cheshire Terminal CLI defaults — site registration, skills, agents, dual-rail forge, agentic wallet mesh.",
  "version": "1.1.0",
  "type": "https://eips.ethereum.org/EIPS/eip-8004#registration-v1",
  "siteUrl": "https://cheshireterminal.ai",
  "companionSiteUrl": "https://solanaclawd.com",
  "env": {
    "CHESHIRE_SITE_URL": "https://cheshireterminal.ai",
    "SOLANA_CLAWD_SITE_URL": "https://solanaclawd.com",
    "CHESHIRE_API_KEY": "",
    "CHESHIRE_WALLET_PASS": "",
    "DFLOW_API_KEY": "",
    "HELIUS_API_KEY": "",
    "SOLANA_TRACKER_API_KEY": "",
    "JUPITER_API_KEY": "",
    "PHANTOM_APP_ID": "",
    "OKX_API_KEY": ""
  },
  "services": [
    {
      "name": "dashboard",
      "endpoint": "https://cheshireterminal.ai",
      "description": "Main dashboard — agent discovery, skills, forge, x402"
    },
    {
      "name": "api",
      "endpoint": "https://cheshireterminal.ai/api",
      "description": "REST API for skills, agents, auth, registry"
    },
    {
      "name": "cli",
      "endpoint": "https://cheshireterminal.ai/cli",
      "description": "CLI hub — install, status, agentic wallet discovery"
    },
    {
      "name": "cli-api",
      "endpoint": "https://cheshireterminal.ai/api/cli",
      "description": "CLI product API + install.sh + file mirror"
    },
    {
      "name": "gateway",
      "endpoint": "https://cheshireterminal.ai/gateway",
      "description": "Developer gateway portal — API keys, OpenAPI, branded /api/gateway/* routes"
    },
    {
      "name": "agents",
      "endpoint": "https://cheshireterminal.ai/agents",
      "description": "Agent hub"
    },
    {
      "name": "mcp",
      "endpoint": "https://cheshireterminal.ai/mcp",
      "description": "Model Context Protocol server"
    },
    {
      "name": "x402",
      "endpoint": "https://cheshireterminal.ai/x402",
      "description": "x402 payment gateway"
    },
    {
      "name": "solanaclawd-cli",
      "endpoint": "https://solanaclawd.com/cli",
      "description": "Companion openclawd / solana-clawd CLI hub (dual mesh)"
    },
    {
      "name": "solanaclawd-api",
      "endpoint": "https://solanaclawd.com/api",
      "description": "Companion openclawd API (skills, agents, marketplace)"
    }
  ],
  "capabilities": {
    "solana": {
      "enabled": true,
      "rpcUrl": "${SOLANA_RPC_URL}",
      "walletSupport": true,
      "agenticWallet": "@x402solana/cheshire-agentic-wallet",
      "kit": "@solana/kit"
    },
    "robinhood": {
      "enabled": true,
      "chains": [4663, 46630]
    },
    "mcp": {
      "enabled": true
    },
    "payment": {
      "enabled": true,
      "protocols": ["x402"],
      "tokens": ["USDC", "CLAWD"]
    }
  },
  "permissions": {
    "defaults": {
      "trade": "ask",
      "sign": "deny",
      "spend": "deny",
      "transfer": "ask"
    }
  }
}
